# Copy to .env and fill in. .env is never committed.
# TikTok username of the LIVE account to listen to (without @). Empty = connector disabled, manual panel only.
TIKTOK_USERNAME=
# Optional Euler Stream sign-server API key used by tiktok-live-connector (higher rate limits).
EULER_API_KEY=
PORT=3000
# Keep 127.0.0.1 unless the panel must be reached from another device on your network.
HOST=127.0.0.1
# Optional shared secret for the control panel / manual trigger. Required in practice if HOST is not 127.0.0.1.
PANEL_TOKEN=
